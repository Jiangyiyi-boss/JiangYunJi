# ============================
# 匠韵集 — 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=project2_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=products
ES_TIMEOUT=5

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=jiangyunji_forum

# JWT
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DeepSeek AI (OpenAI 兼容协议)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
AI_TIMEOUT=120

# Admin
ADMIN_SECRET_KEY=change-me-to-a-random-admin-secret

# App
APP_NAME=匠韵集
APP_VERSION=1.0.0

# Alipay Sandbox
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_APP_PRIVATE_KEY_PATH=keys/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=keys/alipay_public_key.pem
ALIPAY_NOTIFY_URL=http://your-domain/api/payment/notify
ALIPAY_RETURN_URL=http://your-domain/api/payment/callback
ALIPAY_DEBUG=true
