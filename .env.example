# ============================
# 匠韵集 — 根目录环境变量模板
# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 排除）
# 本地: cp .env.example .env
# 服务器: 部署时在 /opt/jiang-yun-ji/ 下同样创建 .env
# ============================

# ---- MySQL root 密码 ----
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ---- JWT ----
SECRET_KEY=your_random_secret_key
ADMIN_SECRET_KEY=your_random_admin_secret

# ---- 支付宝 ----
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_NOTIFY_URL=http://your-domain/api/payment/notify
ALIPAY_RETURN_URL=http://your-domain/api/payment/callback
ALIPAY_DEBUG=true
